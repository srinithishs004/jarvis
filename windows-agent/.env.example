# JARVIS server WebSocket endpoint.
# Use wss:// in production when TLS is enabled.
JARVIS_SERVER_URL=ws://YOUR_JARVIS_SERVER/ws/devices

# Stable unique identifier for this Windows device.
JARVIS_DEVICE_ID=windows-01

# Human-readable Windows device name.
JARVIS_DEVICE_NAME=My Windows PC

# Must match the server's JARVIS_DEVICE_AUTH_SECRET.
JARVIS_DEVICE_AUTH_SECRET=REPLACE_WITH_DEVICE_SECRET
